# ────────────────────────────────────────────────
# IDMS — Integrated Disaster Management System
# Root .gitignore
# ────────────────────────────────────────────────

# Dependencies
node_modules/
__pycache__/
*.pyc
.pytest_cache/

# Environment files — NEVER commit these
.env
.env.local
.env.production

# Build outputs
dist/
dist-ssr/
build/
.vite/

# ML model files — too large for git
idms-ml/model/saved/*.keras
idms-ml/model/saved/*.pkl
idms-ml/model/saved/*.h5

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db
*.local

# IDE / Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Coverage
coverage/

# Misc
*.tgz
