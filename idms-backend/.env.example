# ── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in values from your service dashboards.
# NEVER commit the .env file to git.

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas
# (Atlas → Database → Connect → Drivers → Node.js)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/idms?retryWrites=true&w=majority

# Firebase Admin SDK
# (Firebase Console → Project Settings → Service Accounts → Generate new private key)
FIREBASE_PROJECT_ID=idms-svce
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@idms-svce.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://idms-svce-default-rtdb.firebaseio.com

# HiveMQ Cloud (MQTT)
# (HiveMQ Console → Manage Cluster → Access Management)
MQTT_BROKER_URL=mqtts://your-cluster.hivemq.cloud:8883
MQTT_USERNAME=idms-backend
MQTT_PASSWORD=your-mqtt-password

# JWT
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# FCM (Firebase Cloud Messaging) — auto-enabled, no separate key needed
FCM_SERVER_KEY=your-fcm-server-key

# MSG91 (SMS India) — optional, add when ready
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RESQMX
MSG91_TEMPLATE_ID=

# ML Service
# (Railway URL after deploy, or localhost for dev)
ML_SERVICE_URL=http://localhost:5001

# Alert thresholds (cm — distance from sensor to water surface)
THRESHOLD_SAFE=80
THRESHOLD_WATCH=40
THRESHOLD_WARNING=25
THRESHOLD_DANGER=15
THRESHOLD_CRITICAL=8
